{
    "name": "@vyva/convert",
    "version": "0.1.0",
    "description": "Server-side tools for Vyva content: clean what clients send, import Word, PowerPoint, PDF and Markdown files, and export to PDF, Word, PowerPoint and HTML.",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Pollium/Vyva.git",
        "directory": "packages/convert"
    },
    "files": [
        "dist"
    ],
    "exports": {
        "./*": "./src/*.ts"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            "./*": {
                "types": "./dist/*.d.ts",
                "default": "./dist/*.js"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "oxlint --deny-warnings",
        "test": "vitest run"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/lora": "^5.3.0",
        "@fontsource-variable/merriweather": "^5.3.0",
        "@fontsource-variable/montserrat": "^5.3.0",
        "@fontsource-variable/open-sans": "^5.3.0",
        "@fontsource-variable/playfair-display": "^5.3.0",
        "@fontsource-variable/roboto": "^5.3.0",
        "@vyva/core": "workspace:*",
        "docx": "^9.9.0",
        "htmlparser2": "^10.1.0",
        "pptxgenjs": "^4.0.1",
        "sanitize-html": "^2.18.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/sanitize-html": "^2.16.2",
        "fflate": "^0.8.3",
        "mammoth": "1.13.0"
    }
}
