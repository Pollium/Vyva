{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "moduleDetection": "force",
        "verbatimModuleSyntax": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "erasableSyntaxOnly": true,
        "forceConsistentCasingInFileNames": true,
        "types": []
    }
}
